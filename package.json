{
  "name": "simpleinvoice-manager",
  "version": "0.1.0",
  "private": true,
  "description": "SimpleInvoice Manager – invoices for tradespeople, packaged as a Home Assistant App",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/domain",
    "packages/i18n",
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "build": "tsc -b packages/domain packages/i18n apps/backend && npm run build -w @sim/frontend",
    "typecheck": "tsc -b packages/domain packages/i18n apps/backend && npm run typecheck -w @sim/frontend",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "dev:backend": "npm run dev -w @sim/backend",
    "dev:frontend": "npm run dev -w @sim/frontend",
    "clean": "rm -rf apps/*/dist packages/*/dist **/*.tsbuildinfo"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.0",
    "fast-check": "^4.3.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
